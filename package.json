    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^3.3.18",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@testing-library/react": "^16.3.3",
