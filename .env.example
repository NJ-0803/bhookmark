DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/DATABASE?sslmode=require
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
# Optional. Server-side only. Configure Google Cloud quotas before enabling.
GOOGLE_PLACES_API_KEY=
# Local phone-login testing only. Never enabled in production.
ALLOW_DEV_OTP=0

# Local, read-only chat preview. Disabled in production even if set.
BHOOKMARK_CHAT_PREVIEW=0
# Optional exact cross-origin frontend URLs (comma-separated). Same-origin needs none.
ALLOWED_ORIGINS=
# Self-hosted reverse proxies only: explicit trusted IP/CIDR ranges. Empty trusts none.
# Vercel deployments use their documented immediate platform edge instead.
TRUST_PROXY_CIDRS=
